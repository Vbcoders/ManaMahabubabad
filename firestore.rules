rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /news/{newsId} {
      allow read: if resource.data.published == true || (request.auth != null && resource.data.reporterUid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid;
      allow update: if request.auth != null && resource.data.reporterUid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.reporterUid == request.auth.uid;
    }
  }
}
