rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vikasvikas3339@gmail.com';
    }
    function isOwner() {
      return request.auth != null && resource.data.reporterUid == request.auth.uid;
    }
    function isNewOwner() {
      return request.auth != null && request.resource.data.reporterUid == request.auth.uid;
    }

    match /news/{newsId} {
      allow read: if resource.data.published == true || isOwner() || isAdmin();
      allow create: if isNewOwner()
        && request.resource.data.published == false
        && request.resource.data.rejected == false
        && request.resource.data.status == 'UnderReview';
      allow update: if isAdmin()
        || (isOwner()
          && request.resource.data.reporterUid == resource.data.reporterUid
          && resource.data.status == 'UnderReview'
          && request.resource.data.published == false
          && request.resource.data.rejected == false
          && request.resource.data.status == 'UnderReview');
      allow delete: if isOwner() || isAdmin();
    }

    match /notificationTokens/{tokenId} {
      allow create, update: if request.resource.data.token is string
        && request.resource.data.token.size() > 10
        && request.resource.data.token.size() < 5000;
      allow read, delete: if false;
    }

    match /pushNotifications/{notificationId} {
      allow create: if isAdmin()
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.newsId is string;
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }
  }
}
