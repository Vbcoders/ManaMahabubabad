rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return signedIn() && resource.data.reporterUid == request.auth.uid;
    }

    function isNewOwner() {
      return signedIn() && request.resource.data.reporterUid == request.auth.uid;
    }

    match /news/{newsId} {
      // Public readers can see only approved/published news.
      // Reporters can always read their own submissions.
      allow read: if resource.data.published == true || isOwner();

      // A logged-in reporter can submit a new story.
      // The client cannot submit it as already published or rejected.
      allow create: if isNewOwner()
        && request.resource.data.published == false
        && request.resource.data.rejected == false
        && request.resource.data.status == 'UnderReview';

      // Reporters may update only their own story and may not transfer ownership.
      allow update: if isOwner()
        && request.resource.data.reporterUid == resource.data.reporterUid;

      // Reporters may delete only their own story.
      allow delete: if isOwner();
    }
  }
}
