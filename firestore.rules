rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'vikasvikas3339@gmail.com';
    }

    function isOwner() {
      return request.auth != null
        && resource.data.reporterUid == request.auth.uid;
    }

    function isNewOwner() {
      return request.auth != null
        && request.resource.data.reporterUid == request.auth.uid;
    }

    match /news/{newsId} {
      // Public readers see approved news. Reporter can see own submission. Admin sees all.
      allow read: if resource.data.published == true || isOwner() || isAdmin();

      // Reporter can create a new pending submission only.
      allow create: if isNewOwner()
        && request.resource.data.published == false
        && request.resource.data.rejected == false
        && request.resource.data.status == 'UnderReview';

      // Admin can approve, reject, edit or moderate any story.
      // A reporter may only edit their own still-pending story and cannot self-publish.
      allow update: if isAdmin()
        || (isOwner()
          && request.resource.data.reporterUid == resource.data.reporterUid
          && resource.data.status == 'UnderReview'
          && request.resource.data.published == false
          && request.resource.data.rejected == false
          && request.resource.data.status == 'UnderReview');

      // Reporter may delete own story; admin may delete any story.
      allow delete: if isOwner() || isAdmin();
    }
  }
}
